<div class="relative overflow-hidden min-h-screen" data-controller="inventory-drawer">
  <div class="max-w-6xl mx-auto px-4 py-6 min-h-screen flex flex-col justify-between">
    <header class="flex flex-col lg:flex-row gap-4 justify-between items-start lg:items-center py-4 border-b border-stone-900 mb-8 text-xs font-semibold tracking-widest uppercase text-stone-500 select-none">
      <div class="flex items-center gap-3">
        <span class="inline-block w-2 h-2 rounded-full bg-amber-600 animate-pulse"></span>
        HERO: <span class="text-stone-100 font-extrabold font-mono tracking-tight"><%= @player.name %></span>
      </div>
      <div class="flex flex-wrap gap-3 items-center w-full lg:w-auto justify-between lg:justify-end">
        <div class="flex items-center gap-2 bg-stone-900/40 border border-stone-800/80 px-3 py-1.5 rounded-xl">
          <span class="text-stone-400 text-[10px]">📜 HIKIMA (ELDERS):</span>
          <span id="stat-daura-elders" class="text-amber-500 font-black font-mono text-sm pl-1">
            <%= @player.reputation_for("daura_elders") %>
          </span>
        </div>
        <div class="flex items-center gap-2 bg-stone-900/40 border border-stone-800/80 px-3 py-1.5 rounded-xl">
          <span class="text-stone-400 text-[10px]">🛡️ RINJAYE (ARMY):</span>
          <span id="stat-daura-army" class="text-red-400 font-black font-mono text-sm pl-1">
            <%= @player.reputation_for("daura_army") %>
          </span>
        </div>
        <button data-action="click->inventory-drawer#open"
          class="flex items-center gap-2 bg-amber-950/20 hover:bg-amber-950/40 border border-amber-900/40 hover:border-amber-600/60 px-3 py-1.5 rounded-xl cursor-pointer transition-all text-[11px] font-mono tracking-wider font-bold text-amber-400 ml-auto lg:ml-2">
          🎒 Satchel (<%= @player.inventory_json&.size || 0 %>)
        </button>
      </div>
    </header>
    <%= turbo_frame_tag "game_scene" do %>
      <%= render "game/scene_content" %>
    <% end %>
    <footer class="mt-12 pt-6 border-t border-stone-900 text-[11px] text-stone-600 flex flex-col space-y-1 font-mono">
      <div>
        <span class="text-stone-500 font-semibold uppercase tracking-wider text-[9px] mr-2">Sources & Context:</span>
        <span class="text-stone-400 bg-stone-900/40 px-2 py-0.5 rounded border border-stone-900/60"><%= @room.metadata_json["sources"]&.join(", ") || "Oral Tradition Fragment" %></span>
      </div>
    </footer>
  </div>
  <div data-inventory-drawer-target="overlay"
       data-action="click->inventory-drawer#close"
    class="fixed inset-0 bg-stone-950/80 backdrop-blur-sm z-40 hidden opacity-0 pointer-events-none transition-opacity duration-300 ease-out"></div>
  <div data-inventory-drawer-target="drawer"
       class="fixed top-0 right-0 bottom-0 w-full max-w-md bg-stone-900 border-l border-stone-800 shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-out flex flex-col justify-between">
    <div class="p-6 border-b border-stone-950 flex justify-between items-center bg-stone-950/40 select-none">
      <div class="space-y-0.5">
        <h3 class="text-sm font-bold font-mono tracking-widest uppercase text-amber-500">Player Inventory</h3>
        <p class="text-[11px] font-serif italic text-stone-500">Collected items affecting your paths of fate.</p>
      </div>
      <button data-action="click->inventory-drawer#close"
        class="text-stone-500 hover:text-stone-200 text-xl font-bold p-2 cursor-pointer transition-colors">&times;</button>
    </div>
    <div class="p-6 flex-grow overflow-y-auto space-y-4">
      <% if @player.inventory_json.present? %>
        <div class="grid grid-cols-1 gap-3">
          <% @player.inventory_json.each do |raw_item_slug| %>
            <% item_slug = raw_item_slug.to_s.gsub(/[^a-zA-Z0-9\-_]/, '').strip %>
            <% next if item_slug.blank? %>
            <% item = ItemManifest.lookup(item_slug) %>
            <div class="bg-stone-950/60 border border-stone-800 p-4 rounded-xl flex items-start gap-4 shadow-inner group transition-all duration-300 hover:border-amber-900/40">
              <!-- Dynamic Icon -->
              <div class="w-12 h-12 rounded-lg bg-stone-900 border border-stone-800 flex items-center justify-center text-xl select-none shrink-0 group-hover:bg-amber-950/20 group-hover:border-amber-900/30 transition-colors">
                <%= item[:icon] %>
              </div>
              <div class="space-y-1">
                <!-- Dynamic Title -->
                <h4 class="text-xs font-bold font-mono tracking-wide text-stone-200 uppercase group-hover:text-amber-400 transition-colors">
                  <%= item[:name] %>
                </h4>
                <!-- Dynamic Lore Description -->
                <p class="text-xs text-stone-400 font-serif leading-relaxed">
                  <%= item[:description] %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="h-full flex flex-col items-center justify-center text-center p-8 select-none">
          <div class="text-4xl text-stone-700 mb-2">🎒</div>
          <p class="font-mono text-[11px] text-stone-500 uppercase tracking-widest font-bold">Your Satchel is Empty</p>
          <p class="text-xs font-serif text-stone-600 italic mt-1 max-w-xs">Explore the layout frames and navigate choices safely to obtain historical artifacts.</p>
        </div>
      <% end %>
    </div>
    <div class="p-4 bg-stone-950/40 border-t border-stone-950 text-center select-none">
      <span class="font-mono text-[9px] tracking-widest uppercase text-stone-600">Kusugu Narrative Engine v2.0</span>
    </div>
  </div>
</div>